# Copy to .env for local dev, and set the same variables in Netlify
# (Site configuration → Environment variables). NEVER commit real values —
# .env is gitignored. Do not paste these anywhere public (chat, issues, etc.).

# --- Required for a permanent deploy ---------------------------------------

# Signs login sessions. Any long random string. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=

# Supabase (Project Settings → API). The service_role key is a full-access
# secret — server-side only, never exposed to the browser.
SUPABASE_URL=https://mmnfhynkbggatbukevqn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Voice pipeline (enables real calls) -----------------------------------

# Vapi private/server key (vapi.ai → API Keys). Powers agent sync, outbound
# campaigns, and receiving call events.
VAPI_API_KEY=

# Vapi public key — used by the browser to listen in on live calls.
VAPI_PUBLIC_KEY=

# Shared secret you set on Vapi's server-message webhook, so we can verify
# that incoming call events really came from Vapi.
VAPI_WEBHOOK_SECRET=

# NOTE: ElevenLabs (voices) and Claude/Anthropic (the LLM) keys do NOT go
# here. Add them inside the Vapi dashboard under Provider Keys — Vapi calls
# those providers for us, so the app only ever needs VAPI_API_KEY.
